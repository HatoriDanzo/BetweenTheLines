<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <rect width="1200" height="630" fill="#1e3a8a"/>
  <rect width="1200" height="630" fill="url(#bg-overlay)"/>
  <defs>
    <linearGradient id="bg-overlay" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1d4ed8" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#0f172a" stop-opacity="0.8"/>
    </linearGradient>
  </defs>

  <!-- Decorative lines - subtle document lines top right -->
  <rect x="760" y="80" width="340" height="8" rx="4" fill="#3b82f6" opacity="0.25"/>
  <rect x="760" y="104" width="270" height="8" rx="4" fill="#3b82f6" opacity="0.18"/>
  <rect x="760" y="128" width="310" height="8" rx="4" fill="#3b82f6" opacity="0.20"/>
  <rect x="760" y="152" width="240" height="8" rx="4" fill="#3b82f6" opacity="0.15"/>

  <!-- Report card preview (right side) -->
  <rect x="720" y="200" width="400" height="340" rx="16" fill="#ffffff" opacity="0.07"/>
  <rect x="748" y="230" width="180" height="10" rx="5" fill="#93c5fd" opacity="0.6"/>
  <rect x="748" y="252" width="320" height="7" rx="3.5" fill="#bfdbfe" opacity="0.35"/>
  <rect x="748" y="267" width="280" height="7" rx="3.5" fill="#bfdbfe" opacity="0.28"/>
  <rect x="748" y="282" width="300" height="7" rx="3.5" fill="#bfdbfe" opacity="0.22"/>

  <rect x="748" y="314" width="140" height="10" rx="5" fill="#93c5fd" opacity="0.5"/>
  <rect x="748" y="336" width="320" height="7" rx="3.5" fill="#bfdbfe" opacity="0.30"/>
  <rect x="748" y="351" width="250" height="7" rx="3.5" fill="#bfdbfe" opacity="0.22"/>

  <rect x="748" y="383" width="160" height="10" rx="5" fill="#93c5fd" opacity="0.45"/>
  <!-- Competency chips -->
  <rect x="748" y="405" width="90" height="22" rx="11" fill="#2563eb" opacity="0.5"/>
  <rect x="848" y="405" width="76" height="22" rx="11" fill="#1d4ed8" opacity="0.35"/>
  <rect x="934" y="405" width="100" height="22" rx="11" fill="#2563eb" opacity="0.4"/>
  <rect x="748" y="435" width="110" height="22" rx="11" fill="#1d4ed8" opacity="0.3"/>
  <rect x="868" y="435" width="86" height="22" rx="11" fill="#2563eb" opacity="0.35"/>

  <!-- Left content -->
  <!-- Logo mark -->
  <rect x="80" y="92" width="42" height="42" rx="10" fill="#2563eb"/>
  <rect x="91" y="103" width="20" height="5" rx="2.5" fill="white"/>
  <rect x="91" y="113" width="16" height="5" rx="2.5" fill="white"/>
  <rect x="91" y="123" width="20" height="5" rx="2.5" fill="white"/>

  <!-- Brand name -->
  <text x="136" y="122" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="22" font-weight="600" fill="white" opacity="0.95">Between<tspan font-style="italic">The Lines</tspan></text>

  <!-- Divider -->
  <rect x="80" y="168" width="560" height="1.5" fill="#3b82f6" opacity="0.3"/>

  <!-- Headline -->
  <text x="80" y="255" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="58" font-weight="700" fill="white" letter-spacing="-1">AI Recruiter</text>
  <text x="80" y="325" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="58" font-weight="700" fill="#93c5fd" letter-spacing="-1">Intelligence.</text>

  <!-- Subheading -->
  <text x="80" y="385" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="22" fill="#bfdbfe" opacity="0.85">Upload a CV. Get a senior recruiter's read in 60 seconds.</text>

  <!-- Feature pills -->
  <rect x="80" y="430" width="168" height="36" rx="18" fill="#1d4ed8" opacity="0.6"/>
  <text x="164" y="453" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="14" fill="#bfdbfe" text-anchor="middle">Professional identity</text>

  <rect x="262" y="430" width="148" height="36" rx="18" fill="#1d4ed8" opacity="0.6"/>
  <text x="336" y="453" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="14" fill="#bfdbfe" text-anchor="middle">Evidence gaps</text>

  <rect x="424" y="430" width="162" height="36" rx="18" fill="#1d4ed8" opacity="0.6"/>
  <text x="505" y="453" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="14" fill="#bfdbfe" text-anchor="middle">Interview questions</text>

  <!-- Bottom domain -->
  <text x="80" y="560" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="16" fill="#60a5fa" opacity="0.7">betweenthelines.app</text>
</svg>
